# Files in the repository that should NOT be published on brianyue.me.
# (gitignore syntax; read by Cloudflare's wrangler at deploy time)
.git
.github
.assetsignore
.gitignore
.nojekyll
wrangler.jsonc
tools
inbox
README.md
CLAUDE.md
**/README.md
# full-size photo originals: only the web copies in personal/_web are published
personal/*
!personal/gallery.js
!personal/categories.js
!personal/_web
.wrangler
node_modules

# Stray uploads in the top folder are never published (only the site's own files are)
/*.jpg
/*.JPG
/*.jpeg
/*.JPEG
/*.png
/*.PNG
/*.heic
/*.HEIC
/*.heif
/*.webp
/*.gif
/*.tif
/*.tiff
/*.docx
/*.pptx
!/apple-touch-icon.png
/*.pdf
!/resume.pdf
!/Brian-Yue-Resume.pdf
# stray video and CAD uploads: only the converted copies in media/ are published
/*.mov
/*.MOV
/*.mp4
/*.MP4
/*.m4v
/*.avi
/*.mkv
/*.webm
/*.step
/*.STEP
/*.stp
/*.STP
/*.stl
/*.STL
/*.obj
/*.3mf
/*.glb
/*.gltf
/*.zip
/*.sldprt
/*.SLDPRT
/*.sldasm
/*.SLDASM
